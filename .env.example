# =============================================================================
# TARS Environment Variables
# =============================================================================
# Copy this file to .env and modify as needed:
#   cp .env.example .env
# =============================================================================

# ---------------------------------------------------------------------------
# Phase 1 -- Mission Foundation
# ---------------------------------------------------------------------------

# PX4 SITL connection string for MAVSDK
# Default: connects to PX4 SITL running on localhost via UDP
PX4_CONNECTION=udp://:14540

# Telemetry collection rate in Hz (snapshots per second)
# 1 = one snapshot per second (recommended for your hardware)
# 10 = ten snapshots per second (more data, more CPU)
TELEMETRY_RATE_HZ=1

# Output directory for mission telemetry files
OUTPUT_DIR=output

# Drone identifier (used in telemetry output metadata)
DRONE_ID=tars-sim-01

# ---------------------------------------------------------------------------
# Phase 2 -- Mission Replay System
# ---------------------------------------------------------------------------

# PostgreSQL connection string (async driver for SQLAlchemy)
DATABASE_URL=postgresql+asyncpg://tars:tars@localhost:5432/tars

# FastAPI server host and port
API_HOST=0.0.0.0
API_PORT=8000

# ---------------------------------------------------------------------------
# Phase 3 -- State Engine
# ---------------------------------------------------------------------------

# Redis connection URL (used for operational state store)
REDIS_URL=redis://localhost:6379/0

# Phase 2 Replay API base URL (Phase 3 fetches replay frames from here)
PHASE2_API_URL=http://localhost:8000

# State Engine API host and port (separate from Phase 2)
STATE_API_HOST=0.0.0.0
STATE_API_PORT=8002

# ---------------------------------------------------------------------------
# Phase 4 -- Incident Engine
# ---------------------------------------------------------------------------

# Phase 3 State API base URL (Phase 4 fetches state timelines from here)
PHASE3_API_URL=http://localhost:8002

# Incident Engine API host and port
INCIDENT_API_HOST=0.0.0.0
INCIDENT_API_PORT=8003

# Incident detection thresholds
INCIDENT_MAX_GAP_MS=5000
INCIDENT_MIN_STATES=3
INCIDENT_HIGH_RISK=0.8
INCIDENT_ELEVATED_RISK=0.6

# ---------------------------------------------------------------------------
# Phase 5 -- Gemini Reasoning Layer
# ---------------------------------------------------------------------------

# Phase 4 Incident API base URL (Phase 5 fetches incidents from here)
PHASE4_API_URL=http://localhost:8003

# Reasoning API host and port
REASONING_API_HOST=0.0.0.0
REASONING_API_PORT=8004

# HTTP client timeout for Phase 4 API calls (seconds)
INCIDENT_CLIENT_TIMEOUT=30.0

# Gemini API key (required for live reasoning; leave empty for startup without reasoning)
GEMINI_API_KEY=

# Gemini model identifier
GEMINI_MODEL=gemini-2.5-flash

# Gemini temperature (low for stable operational reasoning)
GEMINI_TEMPERATURE=0.1

# ---------------------------------------------------------------------------
# Phase 6 -- Phoenix Integration (Observability)
# ---------------------------------------------------------------------------

# Enable Phoenix tracing (set to true to activate OpenInference tracing)
PHOENIX_ENABLED=false

# Phoenix OTLP endpoint (where spans are exported)
PHOENIX_ENDPOINT=http://localhost:6006

# Phoenix project name (appears in the Phoenix UI)
PHOENIX_PROJECT_NAME=tars-phase5-reasoning

# Content capture mode: full | metadata | disabled
# full     = capture bounded prompt and structured response (recommended for dev)
# metadata = capture identifiers, model, timing, outcome only (no prompt/response)
# disabled = do not initialize tracing or export spans
PHOENIX_CONTENT_MODE=full

# OTLP export timeout in seconds
PHOENIX_EXPORT_TIMEOUT_SECONDS=5.0

# Use batch span export (recommended for production; false for debugging)
PHOENIX_BATCH_EXPORT=true

# ---------------------------------------------------------------------------
# Phase 7 -- Neo4j Operational Memory
# ---------------------------------------------------------------------------

# Neo4j connection settings
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# Memory API host and port
MEMORY_API_HOST=0.0.0.0
MEMORY_API_PORT=8005

# Upstream API URLs (Phase 7 fetches from these)
# PHASE2_API_URL is already defined above for Phase 3
# PHASE4_API_URL is already defined above for Phase 5
PHASE5_API_URL=http://localhost:8004

# HTTP client timeout for upstream API calls (seconds)
MEMORY_CLIENT_TIMEOUT=30.0

# Query limits for similar-history and neighborhood queries
MEMORY_QUERY_DEFAULT_LIMIT=20
MEMORY_QUERY_MAX_LIMIT=100

# ---------------------------------------------------------------------------
# Phase 8 -- Phoenix MCP Self-Introspection
# ---------------------------------------------------------------------------

# Enable Phoenix MCP trace introspection (disabled by default)
PHOENIX_MCP_ENABLED=false

# Phoenix endpoint for trace queries (reuses the same Phoenix instance)
PHOENIX_MCP_ENDPOINT=http://localhost:6006

# Query timeout in seconds (short because introspection is advisory)
PHOENIX_MCP_TIMEOUT_SECONDS=5.0

# Content mode: metadata | summary | full_dev | disabled
# metadata  = identifiers, attributes, stage timing, safe errors only (default)
# summary   = metadata plus bounded generated summaries
# full_dev  = local dev only; may include bounded prompt/response snippets
# disabled  = disable MCP tool registration and trace queries
PHOENIX_MCP_CONTENT_MODE=metadata

# Default number of traces returned per search
PHOENIX_MCP_DEFAULT_LIMIT=5

# Maximum number of traces returned per search
PHOENIX_MCP_MAX_LIMIT=20

# Maximum trace IDs for comparison tool
PHOENIX_MCP_MAX_TRACE_IDS=10

# Maximum characters in a summary string
PHOENIX_MCP_MAX_SUMMARY_CHARS=2000

# Allow full_dev content mode (must be explicitly enabled)
# WARNING: full_dev may include bounded prompt/response snippets
PHOENIX_MCP_ALLOW_FULL_DEV_CONTENT=false
